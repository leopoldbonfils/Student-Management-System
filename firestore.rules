rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    // users collection
    match /users/{uid} {
      // Teachers can read any user profile; Students can read their own profile
      allow read: if isAuthenticated() && (isOwner(uid) || isTeacher());
      
      // Creating users is done exclusively via Firebase Admin SDK server-side
      allow create: if false;

      // Users can update their own phone, address, avatar, etc., but cannot alter their role, uid, or studentId
      allow update: if isAuthenticated() && isOwner(uid)
                    && !('role' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
                    && !('studentId' in request.resource.data.diff(resource.data).affectedKeys());

      allow delete: if false;
    }

    // attendance collection
    match /attendance/{attendanceId} {
      // Teachers can read all attendance; Students can only read their own records
      allow read: if isAuthenticated() && (isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid));

      // Only teachers can mark or update attendance
      allow create: if isTeacher();
      allow update: if isTeacher();
      allow delete: if false;
    }

    // leaveRequests collection
    match /leaveRequests/{requestId} {
      // Teachers can read all requests; Students can only read their own leave requests
      allow read: if isAuthenticated() && (isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid));

      // Students can create their own pending leave request
      allow create: if isStudent()
                    && request.resource.data.studentId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // Teachers can approve or reject leave requests (updating status, reviewedBy, reviewedAt)
      allow update: if isTeacher()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);

      allow delete: if false;
    }
  }
}
