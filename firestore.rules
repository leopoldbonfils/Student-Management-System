rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // users collection
    match /users/{uid} {
      // Authenticated users can read profiles; updates allowed for the owner
      allow read: if isAuthenticated();
      allow create: if false; // Admin SDK only
      allow update: if isAuthenticated() && (request.auth.uid == uid || request.auth.token.email.matches('.*teacher.*'));
      allow delete: if false; // Admin SDK only
    }

    // attendance collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // leaveRequests collection
    match /leaveRequests/{requestId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if false;
    }
  }
}
